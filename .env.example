# Copy to .env and fill in your keys.
# OPENROUTER_API_KEY: required for gemma-2-2b-it trial generation.
# NEURONPEDIA_API_KEY: optional, raises rate limits for Circuit Tracer.
# KS_EXTRACTION_MODEL: optional, the OpenRouter slug the two knowledge-layer extraction
#   passes run on. Defaults to concept_extractor.DEFAULT_EXTRACTION_MODEL. Any slug
#   OpenRouter serves works; check https://openrouter.ai/models. Without a reachable
#   model the extractor falls back to the deterministic rule-based reader.
# CANON_MAX_OUTPUT_TOKENS: optional, how many tokens one shot may generate (default 512).
#   Raising it lets long answers finish; it also moves the dispersion numbers, since a
#   longer answer is cut into more chunks and every chunk is embedded.

OPENROUTER_API_KEY=""
NEURONPEDIA_API_KEY=""
KS_EXTRACTION_MODEL=""
CANON_MAX_OUTPUT_TOKENS=""
