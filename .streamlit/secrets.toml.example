# Copy to .streamlit/secrets.toml (gitignored) and fill in.
# Both keys are optional for local dev:
#  - OPENROUTER_API_KEY: cloud LLM/embeddings fallback when Ollama isn't running.
#  - NEURONPEDIA_API_KEY: raises rate limits for the Internal Mirror (NLA) panel.
#    The Neuronpedia NLA API also works WITHOUT a key, just rate-limited per IP.
#    Get a free key at https://www.neuronpedia.org/account

OPENROUTER_API_KEY = ""
NEURONPEDIA_API_KEY = ""
